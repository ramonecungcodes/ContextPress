# ContextPress build-time environment.
#
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# build.py loads .env automatically; the Docker `build` service reads it via
# env_file. These feed the ${VAR} placeholders in content/ai.yaml.

# --- AI server (content/ai.yaml) ---
AI_ENABLED=false                 # true to enable the build-time AI server
AI_PROVIDER=lmstudio             # lmstudio | openai
AI_SCHEME=http                   # http | https
AI_HOST=localhost
AI_PORT=1234                     # blank -> 80 (http) / 443 (https). LM Studio: 1234
AI_API_KEY=                      # REQUIRED for openai; keep secret

# Models by role (leave blank for roles you don't use)
AI_MODEL_EMBEDDINGS=
AI_MODEL_CHAT=
AI_MODEL_VISION=
AI_MODEL_TOOLS=
AI_MODEL_RERANK=
AI_MODEL_CODE=
AI_MODEL_TRANSCRIPTION=
AI_MODEL_MODERATION=
